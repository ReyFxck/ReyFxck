        L19.62,7.38
        C19.86,7.18 20.22,7.22 20.42,7.47
        C20.62,7.73 20.56,8.08 20.32,8.28
        L19.05,9.33
        C18.53,9.77 18.02,10.10 17.35,10.30
        C18.05,10.77 18.90,11.02 19.78,11.02
        C21.67,11.02 23.20,9.53 23.20,7.68
        V4.67 Z
    </string>

    <!-- Samsung charging-bolt geometry adapted to the 24x16 canvas. -->
    <string name="config_batterymeterBoltPath" translatable="false">
        M22.146,8.266
        L19.074,11.886
        C18.818,12.114 18.569,11.892 18.640,11.704
        L19.829,9.095
        C19.851,9.035 19.807,8.972 19.744,8.972
