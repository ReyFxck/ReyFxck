<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- One UI 8 style, adapted to Axion's status-bar renderer. -->
    <integer name="config_batteryOverrideStyle">0</integer>

    <integer name="config_batterymeterWidth">24</integer>
    <integer name="config_batterymeterHeight">16</integer>

    <bool name="config_batterymeterHorizontalFill">true</bool>
    <bool name="config_batterymeterReverseFill">false</bool>
    <bool name="config_batterymeterDualTone">true</bool>

    <!--
         Axion normally paints the whole level with its saver/error color.
         Using the error path instead lets power-save keep the normal capsule
         and draw only a compact Samsung-style saver mark on the right.
    -->
    <bool name="config_batterymeterPowerSaveDrawError">true</bool>

    <integer name="config_batterymeterLevelCornerRadius">8</integer>
    <integer name="config_batterymeterCriticalLevel">15</integer>

    <!-- Slightly smaller than v3; visually closer to Samsung at 2 digits. -->
    <integer name="config_batterymeterTextStyle">3</integer>
    <integer name="config_batterymeterTextSizePct">60</integer>
    <bool name="config_batterymeterGlyphFollowFrame">false</bool>

    <bool name="config_batterymeterBoltKnockout">true</bool>
    <bool name="config_themedBatteryPercentWhileCharging">true</bool>

    <color name="config_batterymeterChargingFillColor">#FF34C759</color>

    <!-- Transparent disables Axion's full-capsule saver fill override. -->
    <color name="config_batterymeterPowerSaveFillColor">#00000000</color>

    <!--
         Visible capsule is inset from the 24x16 logical canvas.
         The real ImageView remains 13sp high, so antialiasing has enough pixels,
         while the visible body becomes slightly slimmer than v3.
    -->
    <string name="config_batterymeterPerimeterPath" translatable="false">
        M8.2,0.8 H15.8
        C19.776,0.8 23,4.024 23,8
        C23,11.976 19.776,15.2 15.8,15.2
        H8.2
        C4.224,15.2 1,11.976 1,8
        C1,4.024 4.224,0.8 8.2,0.8 Z
    </string>

    <string name="config_batterymeterFillMask" translatable="false">
        @string/config_batterymeterPerimeterPath
    </string>

    <!--
         Power-save marker: compact leaf derived from Samsung's battery saver
         icon language, placed at the far right so it does not cover 2-digit text.
    -->
    <string name="config_batterymeterErrorPerimeterPath" translatable="false">
        M20.15,4.65
        C18.45,4.65 17.05,6.02 17.05,7.75
        C17.05,8.22 17.16,8.65 17.36,9.05
